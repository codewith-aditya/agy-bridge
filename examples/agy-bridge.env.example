# Copy to agy-bridge.env and chmod 600.

# OpenAI-compatible upstream
UPSTREAM_BASE=https://api.openai.com/v1

# Leave UPSTREAM_KEY empty to make every caller spend their own key.
# UPSTREAM_KEY=sk-...

# Required for the Antigravity IDE route (callers present a Google OAuth bearer).
# CLOUD_SERVER_KEY=sk-...

DEFAULT_MODEL=gpt-4o-mini
MODEL_MAP=gemini-3.1-pro-preview=gpt-4o,gemini-3-flash=gpt-4o-mini
MAX_OUTPUT_TOKENS=32000
LISTEN=127.0.0.1:8198
